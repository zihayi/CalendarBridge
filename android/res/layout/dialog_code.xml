<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingVertical="12dp">
        <TextView android:id="@+id/pair_computer" style="@style/Label.Body" android:maxLines="3" android:ellipsize="end" />
        <TextView android:id="@+id/verification_code" style="@style/Label" android:layout_width="match_parent" android:minHeight="68dp" android:padding="8dp"
            android:layout_marginVertical="14dp" android:background="@drawable/soft_tile" android:gravity="center" android:fontFamily="monospace" android:textColor="@color/green_dark"
            android:textSize="30sp" android:letterSpacing="0.14" android:text="···" android:accessibilityLiveRegion="polite" />
        <TextView style="@style/Label.Body" android:text="仅当两端显示相同的六位验证码时，才在电脑点击「验证码一致，允许配对」。" />
    </LinearLayout>
</ScrollView>
