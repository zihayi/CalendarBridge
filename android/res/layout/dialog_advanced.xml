<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAutofill="noExcludeDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="20dp" android:paddingTop="10dp" android:paddingBottom="4dp" android:focusableInTouchMode="true">
        <TextView style="@style/Label.Body" android:text="使用电脑生成的 pairing.json，或在下方填写配对信息。" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="14dp" android:baselineAligned="false">
            <Button android:id="@+id/import_file" style="@style/Action.Half" android:text="@string/import_file" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/paste_config" style="@style/Action.Half" android:text="@string/paste_config" />
        </LinearLayout>
        <TextView style="@style/Label.Small" android:labelFor="@+id/server" android:text="电脑地址" />
        <EditText android:id="@id/server" style="@style/Field" android:inputType="textUri" android:hint="https://…" />
        <TextView style="@style/Label.Small" android:labelFor="@+id/token" android:text="配对密钥" />
        <EditText android:id="@id/token" style="@style/Field" android:inputType="textPassword" android:hint="配对文件中的密钥" />
        <TextView style="@style/Label.Small" android:labelFor="@+id/pin" android:text="电脑证书指纹" />
        <EditText android:id="@id/pin" style="@style/Field" android:inputType="textNoSuggestions" android:hint="SHA-256" />
        <TextView android:id="@+id/form_message" style="@style/Label.Small" android:accessibilityLiveRegion="polite" android:text="更换配对电脑后，需重新开启编辑权限。" />
    </LinearLayout>
</ScrollView>
